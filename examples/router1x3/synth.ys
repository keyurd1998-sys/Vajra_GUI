# Synthesis and Schematic Export Script for Router1x3
# Using Yosys and Vajra GUI Plugin

# Read RTL files
read_verilog rtl/router_fifo.v
read_verilog rtl/router_fsm.v
read_verilog rtl/router_reg.v
read_verilog rtl/router_sync.v
read_verilog rtl/router_top.v

# Elaborate design hierarchy
hierarchy -check -top router_top

# Convert processes to netlist elements and perform optimizations
proc; opt

# Launch GUI
gui 